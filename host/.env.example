# Copy to .env and fill in. .env is gitignored, so never commit your key.
ANTHROPIC_API_KEY=sk-ant-...

# ESP32 serial port: "auto" listens on each USB serial device for the firmware's
# PRESENCE heartbeat and uses that one, or give it explicitly (ls /dev/cu.*),
# e.g. /dev/cu.usbmodem1101
SKULL_PORT=auto

# Audio devices (part of the name works) and any other skull.py options.
# Add --mode presenter to start as Bob, the presenter (say "switch to skull mode" to change back).
SKULL_ARGS="--in-device ReSpeaker --out-device ReSpeaker"

# skull.py (deep villain voice) or skull_british.py
SKULL_SCRIPT=skull.py

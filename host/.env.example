# Copy to .env and fill in. .env is gitignored, so never commit your key.
ANTHROPIC_API_KEY=sk-ant-...

# ESP32 serial port: "auto" picks the first USB serial device, or give it explicitly
# (ls /dev/cu.*), e.g. /dev/cu.usbmodem1101
SKULL_PORT=auto

# Audio devices (part of the name works) and any other skull.py options
SKULL_ARGS="--in-device ReSpeaker --out-device ReSpeaker"

# skull.py (deep villain voice) or skull_british.py
SKULL_SCRIPT=skull.py
